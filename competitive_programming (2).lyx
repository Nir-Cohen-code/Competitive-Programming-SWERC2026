\end_layout

\begin_layout Section*
Modular exponentiation
\end_layout

\begin_layout Standard

\size small
e >= 0;
 1 <= mod <= 10^9 + 7.
 O(log e).
\end_layout

\begin_layout Standard
\begin_inset listings
lstparams "language={C++}"
inline false
status open

\begin_layout Plain Layout

ll modpow(ll a,
 ll e,
 ll mod) {
\end_layout

\begin_layout Plain Layout

  a = (a % mod + mod) % mod;
\end_layout

\begin_layout Plain Layout

  ll r = 1 % mod;
\end_layout

\begin_layout Plain Layout

  while (e) {
\end_layout

\begin_layout Plain Layout

    if (e & 1) r = r * a % mod;
\end_layout

\begin_layout Plain Layout

    a = a * a % mod;
\end_layout

\begin_layout Plain Layout

    e >>= 1;
\end_layout

\begin_layout Plain Layout

  }
\end_layout

\begin_layout Plain Layout

  return r;
\end_layout

\begin_layout Plain Layout

}
\end_layout

