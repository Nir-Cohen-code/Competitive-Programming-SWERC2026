\begin_layout Plain Layout

vector<int> bfs(const vector<vector<int>>& g,
\end_layout

\begin_layout Plain Layout

                int s) {
\end_layout

\begin_layout Plain Layout

  vector<int> d(g.size(),
 -1);
\end_layout

\begin_layout Plain Layout

  queue<int> q;
\end_layout

\begin_layout Plain Layout

  d[s] = 0;
 q.push(s);
\end_layout

\begin_layout Plain Layout

  while (!q.empty()) {
\end_layout

\begin_layout Plain Layout

    int v = q.front();
 q.pop();
\end_layout

\begin_layout Plain Layout

    for (int u :
 g[v]) if (d[u] == -1) {
\end_layout

\begin_layout Plain Layout

      d[u] = d[v] + 1;
\end_layout

\begin_layout Plain Layout

      q.push(u);
\end_layout

\begin_layout Plain Layout

    }
\end_layout

\begin_layout Plain Layout

  }
\end_layout

\begin_layout Plain Layout

  return d;
\end_layout

