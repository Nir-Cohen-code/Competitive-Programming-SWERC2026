\begin_layout Standard
\begin_inset listings
lstparams "language={C++}"
inline false
status open

\begin_layout Plain Layout

struct Fenwick {
\end_layout

\begin_layout Plain Layout

  int n;
 vector<ll> bit;
\end_layout

\begin_layout Plain Layout

  Fenwick(int n) :
 n(n),
 bit(n + 1,
 0) {}
\end_layout

\begin_layout Plain Layout

  void add(int i,
 ll delta) { // 0 <= i < n
\end_layout

\begin_layout Plain Layout

    for (++i;
 i <= n;
 i += i & -i)
\end_layout

\begin_layout Plain Layout

      bit[i] += delta;
\end_layout

\begin_layout Plain Layout

  }
\end_layout

\begin_layout Plain Layout

  ll prefix(int r) { // sum [0,r)
\end_layout

\begin_layout Plain Layout

    ll ans = 0;
\end_layout

\begin_layout Plain Layout

    for (;
 r > 0;
 r -= r & -r)
\end_layout

\begin_layout Plain Layout

      ans += bit[r];
\end_layout

\begin_layout Plain Layout

    return ans;
\end_layout

\begin_layout Plain Layout

  }
\end_layout

\begin_layout Plain Layout

  ll sum(int l,
 int r) {
\end_layout

\begin_layout Plain Layout

    return prefix(r) - prefix(l);
\end_layout

\begin_layout Plain Layout

  }
\end_layout

\begin_layout Plain Layout

};
