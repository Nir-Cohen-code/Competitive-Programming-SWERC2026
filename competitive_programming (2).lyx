\begin_layout Standard
\begin_inset listings
lstparams "language={C++}"
inline false
status open

\begin_layout Plain Layout

int first_ge(const vector<int>& a,
 int x) {
\end_layout

\begin_layout Plain Layout

  int lo = 0,
 hi = (int)a.size();
\end_layout

\begin_layout Plain Layout

  while (lo < hi) {
\end_layout

\begin_layout Plain Layout

    int mid = lo + (hi - lo) / 2;
\end_layout

\begin_layout Plain Layout

    if (a[mid] < x) lo = mid + 1;
\end_layout

\begin_layout Plain Layout

    else hi = mid;
\end_layout

\begin_layout Plain Layout

  }
\end_layout

\begin_layout Plain Layout

  return lo;
 // size() if no such index
\end_layout

\begin_layout Plain Layout

}
\end_layout

