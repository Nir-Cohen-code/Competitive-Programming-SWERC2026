\begin_layout Section*
Dijkstra shortest paths
\end_layout

\begin_layout Standard

\size small
Nonnegative weights;
 distances < INF.
 O((V+E) log V).
\end_layout

\begin_layout Standard
\begin_inset listings
lstparams "language={C++}"
inline false
status open

\begin_layout Plain Layout

const ll INF = (1LL << 62);
\end_layout

\begin_layout Plain Layout

using Graph = vector<vector<pair<int,
 ll>>>;
\end_layout

\begin_layout Plain Layout

vector<ll> dijkstra(const Graph& g,
 int s) {
\end_layout

\begin_layout Plain Layout

  vector<ll> d(g.size(),
 INF);
\end_layout

\begin_layout Plain Layout

  using State = pair<ll,
 int>;
\end_layout

\begin_layout Plain Layout

  priority_queue<State,
 vector<State>,
\end_layout

\begin_layout Plain Layout

                 greater<State>> pq;
\end_layout

\begin_layout Plain Layout

  d[s] = 0;
 pq.push({0,
 s});
\end_layout

\begin_layout Plain Layout

  while (!pq.empty()) {
\end_layout

\begin_layout Plain Layout

    auto [dv,
 v] = pq.top();
 pq.pop();
\end_layout

\begin_layout Plain Layout

    if (dv != d[v]) continue;
\end_layout

\begin_layout Plain Layout

    for (auto [u,
 w] :
 g[v]) {
\end_layout

\begin_layout Plain Layout

      if (w >= INF - dv) continue;
\end_layout

\begin_layout Plain Layout

      if (dv + w < d[u]) {
\end_layout

\begin_layout Plain Layout

        d[u] = dv + w;
\end_layout

\begin_layout Plain Layout

        pq.push({d[u],
 u});
\end_layout

\begin_layout Plain Layout

      }
\end_layout

\begin_layout Plain Layout

    }
\end_layout

\begin_layout Plain Layout

  }
\end_layout

\begin_layout Plain Layout

  return d;
\end_layout

\begin_layout Plain Layout

}
\end_layout

