\begin_layout Plain Layout

struct DSU {
\end_layout

\begin_layout Plain Layout

  vector<int> p,
 sz;
\end_layout

\begin_layout Plain Layout

  DSU(int n) :
 p(n),
 sz(n,
 1) {
\end_layout

\begin_layout Plain Layout

    iota(p.begin(),
 p.end(),
 0);
\end_layout

\begin_layout Plain Layout

  }
\end_layout

\begin_layout Plain Layout

  int find(int x) {
\end_layout

\begin_layout Plain Layout

    return p[x] == x ?
 x :
 p[x] = find(p[x]);
\end_layout

\begin_layout Plain Layout

  }
\end_layout

\begin_layout Plain Layout

  bool unite(int a,
 int b) {
\end_layout

\begin_layout Plain Layout

    a = find(a);
 b = find(b);
\end_layout

\begin_layout Plain Layout

    if (a == b) return false;
\end_layout

\begin_layout Plain Layout

    if (sz[a] < sz[b]) swap(a,
 b);
\end_layout

\begin_layout Plain Layout

    p[b] = a;
 sz[a] += sz[b];
\end_layout

\begin_layout Plain Layout

    return true;
\end_layout

\begin_layout Plain Layout

  }
\end_layout

